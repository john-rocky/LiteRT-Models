# idol F0 (2026-11-09): one block of each heavy Idol part on the Galaxy S26 GPU (SM8850, Adreno 840, 12 GB).
# Runner = the shared C-API runner litertlm-convert/asr_vlm_gpu_cl_work/tools/r3_rt_runner.cc, its LiteRT 2.3.0 build
# (out/r3/rt/230/r3_rt_runner, reused as is, sha256 below), with the 2.3.0 Maven libLiteRt.so (litert-2.3.0.aar) and
# libLiteRtClGlAccelerator.so (litert-gpu-2.3.0.aar) in device/stage/libs230g. Plan = device/plan_<round>.tsv.
LANE=${LANE:-idol}
DEVICE=${DEVICE:-s26}
SERIAL=${SERIAL:-RFGL80R6A6H}
HOLD=${HOLD:-$CA/s2_npu_sweep/.device_hold}
SCRIPT_NAME=${SCRIPT_NAME:-idol-$ROUND-s26}
NPU_RUNNER_NAME=${NPU_RUNNER_NAME:-r3_rt_runner}
NPU_STAGE=${NPU_STAGE:-/data/local/tmp/idol_$ROUND}
NPU_RUNNER=${NPU_RUNNER:-$DEVICE_DIR/stage/r3_rt_runner}
NPU_RUNNER_SHA=${NPU_RUNNER_SHA:-7e7539e5bd0c73ed121a211a7021017e220757c526b6bca72a8d9089eefe68a1}
NPU_LIBS=${NPU_LIBS:-$DEVICE_DIR/stage/libs230g}
NPU_LIBS_SUMS=${NPU_LIBS_SUMS:-$NPU_LIBS/SHA256SUMS}
FX_ROOT=${FX_ROOT:-$DEVICE_DIR/fx}
GRAPH_DIR=${GRAPH_DIR:-$LANE_DIR/models/$ROUND}
RESULTS_DIR=${RESULTS_DIR:-$DEVICE_DIR/results}
MEM_GUARD_KB=${MEM_GUARD_KB:-1000000}
PY=${PY:-$HOME/venvs/idol/bin/python}
